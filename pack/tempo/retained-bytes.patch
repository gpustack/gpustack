+// localBlockSizes counts the files in searchable blocks, including their indexes
+// and bloom filters. WAL and compacted blocks have separate lifecycles.
+func localBlockSizes(root, tenant string, blocks []*backend.BlockMeta) (map[backend.UUID]uint64, uint64, error) {
+	sizes := make(map[backend.UUID]uint64, len(blocks))
+	var total uint64
+	for _, block := range blocks {
+		files, err := os.ReadDir(filepath.Join(root, tenant, block.BlockID.String()))
+		if os.IsNotExist(err) {
+			continue
+		}
+		if err != nil {
+			return nil, 0, err
+		}
+		for _, file := range files {
+			if !file.Type().IsRegular() {
+				continue
+			}
+			info, err := file.Info()
+			if os.IsNotExist(err) {
+				continue
+			}
+			if err != nil {
+				return nil, 0, err
+			}
+			sizes[block.BlockID] += uint64(info.Size())
+		}
+		total += sizes[block.BlockID]
+	}
+	return sizes, total, nil
+}
