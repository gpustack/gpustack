+func TestRetentionCapsLocalStorage(t *testing.T) {
+	tempDir := t.TempDir()
+	store := path.Join(tempDir, "traces")
+	r, w, c, err := New(&Config{
+		Backend: backend.Local,
+		Local:   &local.Config{Path: store},
+		Block: &common.BlockConfig{
+			BloomFP: 0.01, BloomShardSizeBytes: 100_000,
+			IndexDownsampleBytes: 17, IndexPageSizeBytes: 1000,
+			Version: encoding.DefaultEncoding().Version(),
+		},
+		WAL: &wal.Config{Filepath: path.Join(tempDir, "wal")},
+	}, nil, log.NewNopLogger())
+	require.NoError(t, err)
+	ctx := context.Background()
+	cfg := &CompactorConfig{
+		MaxCompactionRange: time.Hour, BlockRetention: 7 * 24 * time.Hour,
+		CompactedBlockRetention: time.Hour, RetentionConcurrency: 1,
+	}
+	require.NoError(t, c.EnableCompaction(ctx, cfg, &mockSharder{}, &mockOverrides{}))
+	want := make([]*backend.BlockMeta, 0, 4)
+	for i, age := range []time.Duration{8 * 24 * time.Hour, 3 * time.Hour, 2 * time.Hour, time.Hour} {
+		meta := &backend.BlockMeta{BlockID: backend.NewUUID(), TenantID: testTenantID}
+		head, err := w.WAL().NewBlock(meta, model.CurrentEncoding)
+		require.NoError(t, err)
+		complete, err := w.CompleteBlock(ctx, head)
+		require.NoError(t, err)
+		meta = complete.BlockMeta()
+		meta.StartTime = time.Now().Add(-age)
+		meta.EndTime = meta.StartTime.Add(time.Minute)
+		// Make the oldest unexpired block larger so one eviction is sufficient.
+		if i == 1 {
+			require.NoError(t, os.WriteFile(path.Join(store, testTenantID, meta.BlockID.String(), "bloom-extra"), make([]byte, 131072), 0o600))
+		}
+		want = append(want, meta)
+	}
+	rw := r.(*readerWriter)
+	rw.blocklist.Update(testTenantID, want, nil, nil, nil)
+	_, cfg.MaxRetainedBytes, err = localBlockSizes(store, testTenantID, want[2:])
+	require.NoError(t, err)
+	rw.doRetention(ctx)
+	require.Equal(t, want[2:], rw.blocklist.Metas(testTenantID))
+	require.Len(t, rw.blocklist.CompactedMetas(testTenantID), 2)
+	_, bytes, err := localBlockSizes(store, testTenantID, rw.blocklist.Metas(testTenantID))
+	require.NoError(t, err)
+	require.LessOrEqual(t, bytes, cfg.MaxRetainedBytes)
+
+	cfg.CompactedBlockRetention = 0
+	rw.doRetention(ctx)
+	require.Empty(t, rw.blocklist.CompactedMetas(testTenantID))
+	for _, evicted := range want[:2] {
+		_, err := os.Stat(path.Join(store, testTenantID, evicted.BlockID.String()))
+		require.ErrorIs(t, err, os.ErrNotExist)
+	}
